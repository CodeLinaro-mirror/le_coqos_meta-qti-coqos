SUMMARY = "Linaro GNU GCC ${PV} toolchain prebuilt package"
DESCRIPTION = "Linaro GNU GCC ${PV} toolchain prebuilt package"

LICENSE = "GPL-3.0-with-GCC-exception"
LIC_FILES_CHKSUM = " \
    file://${COMMON_LICENSE_DIR}/GPL-3.0-with-GCC-exception;md5=aef5f35c9272f508be848cd99e0151df \
"

GROUP_ID = "aarch64-elf"

ARTIFACT_FILENAME = "gcc-linaro-${PV}-x86_64_${GROUP_ID}.${TYPE}"

SRC_ROOT_URI = "https://releases.linaro.org"
SRC_BASE_URI = "${SRC_ROOT_URI}/${REPOSITORY}"
SRC_URI = "${SRC_BASE_URI}/${GROUP_PV}/${GROUP_ID}/${ARTIFACT_FILENAME};name=gcc-linaro-${CLASSIFIER}"

PROVIDES += "${ARTIFACT_ID}-${CLASSIFIER}-prebuilt-${PV}"

inherit siteinfo
inherit native

TOOLCHAIN_VENDOR = "linaro"

# Take version numbering scheme for GCC 5 and later into account when extracting
# the toolchain version from PV. Starting with GCC 5, the major version number
# is bumped for each release.
TOOLCHAIN_VERSION = "${@oe.utils.version_less_or_equal('PV', '4.10', \
                    d.getVar('PV', True).split('-', 1)[0], \
                    d.getVar('PV', True).split('.', 1)[0], d)}"

# Register binary providers for the detected host architecture.
# To explicitly override the host arch/bits detection, for example to allow installing
# 32-bit binaries on a 64-bit host, create separate recipes with the
# package/file name (PN) containing the classifier and override the CLASSIFIER
# variable in the recipe.

TOOLCHAIN_RELEASE    = "${@d.getVar('PV', True).split('-', 1)[1]}"

TOOLCHAIN_BIN_PREFIX = "${TOOLCHAIN_TARGET}"
# encode <vendor> into tuple when new-style 'none' or 'unknown' is set in TOOLCHAIN_VENDOR
TOOLCHAIN_BIN_PREFIX .= "${@bb.utils.contains("TOOLCHAIN_VENDOR", "none", "-none", "", d)}"
TOOLCHAIN_BIN_PREFIX .= "${@bb.utils.contains("TOOLCHAIN_VENDOR", "unknown", "-unknown", "", d)}"
TOOLCHAIN_BIN_PREFIX .= "-${TOOLCHAIN_PLATFORM}"
TOOLCHAIN_BIN_PREFIX .= "-${TOOLCHAIN_ABI}-"

generate_toolchain_spec () {
cat <<EOF > ${S}/toolchain.mk
# This file is generated by the ${PN} recipe, do not edit
toolchain := ${TOOLCHAIN_DESTDIR}

\$(toolchain)_PREFIX   := ${TOOLCHAIN_BIN_PREFIX}
\$(toolchain)_PATH     := ${TMPDIR}/work-shared/opsy/toolchains/${TOOLCHAIN_DESTDIR}/bin/
\$(toolchain)_TARGET   := ${TOOLCHAIN_TARGET}
\$(toolchain)_PLATFORM := ${TOOLCHAIN_PLATFORM}
\$(toolchain)_HOST     := ${CLASSIFIER}
\$(toolchain)_VENDOR   := ${TOOLCHAIN_VENDOR}
\$(toolchain)_ABI      := ${TOOLCHAIN_ABI}
\$(toolchain)_LIBC     := ${TOOLCHAIN_LIBC}
\$(toolchain)_VERSION  := ${TOOLCHAIN_VERSION}
\$(toolchain)_RELEASE  := ${TOOLCHAIN_RELEASE}

TOOLCHAINS += \$(toolchain)
EOF
}

# anonymous python function (executed at parser pass) to automatically
# set classifier if not set by recipes
python () {
    hostbits = d.getVar('SITEINFO_BITS', d, True)
    if hostbits == "32":
        classifier = "linux-x86"
        hostarch = "x86"
    elif hostbits == "64":
        classifier = "linux-x86_64"
        hostarch = "x86_64"
    else:
        # bitness unknown, bail here rather than making invalid assumptions
        raise Exception("SITEINFO_BITS not 32 or 64 bit.")

    if d.getVar('CLASSIFIER', True) == None:
        d.setVar('CLASSIFIER', classifier)

    if d.getVar('HOSTARCH', True) == None:
        d.setVar('HOSTARCH', hostarch)
}

S = "${WORKDIR}/gcc-${TOOLCHAIN_VENDOR}-${PV}-${HOSTARCH}_${TOOLCHAIN_TARGET}-${TOOLCHAIN_ABI}"

D = "${TMPDIR}/work-shared/toolchains/${TOOLCHAIN_DESTDIR}"

do_install () {
    generate_toolchain_spec
    cp -r ${S}/* ${D}
}

# Skip the unwanted steps
do_patch[noexec] = "1"
do_configure[noexec] = "1"
do_compile[noexec] = "1"

# Do not create packages(*.ipk or *.rpm) for this recipe
PACKAGES = ""
inherit nopackages