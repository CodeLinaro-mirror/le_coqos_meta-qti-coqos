@@ -1589,12 +1560,10 @@ static void set_stream_out_varyings(ASSERTED struct vrend_sub_context *sub_ctx,
          varyings[n_outputs++] = strdup(sinfo->so_names[i]);
    }
 
-   skip = so->stride[last_buffer] - buf_offset;
