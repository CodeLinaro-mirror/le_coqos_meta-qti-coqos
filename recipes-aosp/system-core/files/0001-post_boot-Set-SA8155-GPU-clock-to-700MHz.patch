From c0c0bb0f58150e4e2d9954cb435a1a1cfe8d7d78 Mon Sep 17 00:00:00 2001
From: Marcin Mozejko <mmozejko@qti.qualcomm.com>
Date: Thu, 8 Aug 2024 11:16:33 +0200
Subject: [PATCH 1/3] post_boot: Set SA8155 GPU clock to 700MHz.

Tune-up GPU clock to improve GLMark score.

Signed-off-by: Marcin Mozejko <mmozejko@qti.qualcomm.com>
---
 rootdir/etc/init.qcom.post_boot.sh | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/rootdir/etc/init.qcom.post_boot.sh b/rootdir/etc/init.qcom.post_boot.sh
index 27bbe1442..a2582e62f 100755
--- a/rootdir/etc/init.qcom.post_boot.sh
+++ b/rootdir/etc/init.qcom.post_boot.sh
@@ -356,6 +356,20 @@ configure_sa8195_sku_parameters() {
     fi
 }
 
+configure_sa8155_gpu_clock() {
+    sysfs_gpu=/sys/devices/platform/soc/2c00000.qcom,kgsl-3d0/devfreq/2c00000.qcom,kgsl-3d0
+
+    if [ -f ${sysfs_gpu}/governor ]; then
+        echo performance > ${sysfs_gpu}/governor
+    fi
+    if [ -f ${sysfs_gpu}/min_freq ]; then
+        echo 700000000 > ${sysfs_gpu}/min_freq
+    fi
+    if [ -f /sys/kernel/gpu/gpu_min_clock ]; then
+        echo 700 > /sys/kernel/gpu/gpu_min_clock
+    fi
+}
+
 case "$1" in
 start)
 if [ -f /sys/devices/soc0/machine ]; then
@@ -379,6 +393,7 @@ case "$target" in
     "sa8155p" |"sa8155" )
     #configure_memory_parameters
     configure_sa8155_sku_parameters
+    configure_sa8155_gpu_clock
 
     # Core control parameters for gold
     echo 2 > /sys/devices/system/cpu/cpu${gold_core}/core_ctl/min_cpus
-- 
2.49.0

