+static gboolean
+gst_omx_video_dec_sink_event (GstVideoDecoder * bdec, GstEvent * event)
+{
+  GstOMXVideoDec *self = GST_OMX_VIDEO_DEC (bdec);
+  gboolean ret;
+  GstEventType type = GST_EVENT_TYPE (event);
+
+  switch (type) {
+    case GST_EVENT_FLUSH_START:
+      g_mutex_lock (&self->reconfigure_lock);
+      gst_omx_port_set_flushing (self->dec_in_port, 2 * GST_SECOND, TRUE);
+      gst_omx_port_set_flushing (self->dec_out_port, 2 * GST_SECOND, TRUE);
+      g_mutex_unlock (&self->reconfigure_lock);
+      break;
+    default:
+      break;
+  }
+
+  ret =
+      GST_VIDEO_DECODER_CLASS (gst_omx_video_dec_parent_class)->sink_event
+      (bdec, event);
+
+  switch (type) {
+    case GST_EVENT_FLUSH_START:
+      gst_pad_stop_task (GST_VIDEO_DECODER_SRC_PAD (bdec));
+      GST_DEBUG_OBJECT (self, "flush start done");
+      break;
+    default:
+      break;
+  }
+
+  return ret;
+}
